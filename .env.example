# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production
FLASK_ENV=development

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# ADMIN_PASSWORD_HASH=
# ADMIN_TOKEN_TTL_SECONDS=86400

# Celery Configuration
CELERY_BROKER=redis://localhost:6379/0
CELERY_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=0

# Database Configuration
DATABASE_URI=sqlite:///backups.db

# CORS Configuration
CORS_ORIGINS=*

# Backup Configuration
MAX_BACKUPS=10
BACKUP_RETENTION_DAYS=30

# MySQL Deployment Controller
# Set these only after provisioning a reviewed known_hosts file.
DEPLOYMENT_DBOPS_ROOT=./deployments/dbops_mysql
DEPLOYMENT_KNOWN_HOSTS_PATH=./deployments/known_hosts/known_hosts
# DEPLOYMENT_WORK_DIR=/var/lib/db-ai-ops/deployment-work
